    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="SharedTextFontChecks.cs" />
    <Compile Include="../../guideXOS/Kernel/Misc/TrueTypeFont.cs" Link="TrueTypeFont.cs" />
    <Compile Include="../../Kernel/Misc/IFont.cs" Link="IFont.cs" />
    <Compile Include="../../Kernel/Misc/SharedTextFont.cs" Link="SharedTextFont.cs" />
    <Compile Include="../../guideXOS/GUI/UefiDesktopInteraction.cs" Link="UefiDesktopInteraction.cs" />
    <Compile Include="../../guideXOS/GUI/UefiDesktopLabelRenderer.cs" Link="UefiDesktopLabelRenderer.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../Ramdisk/Fonts/roboto/Roboto-Regular.ttf"
          Link="Roboto-Regular.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
