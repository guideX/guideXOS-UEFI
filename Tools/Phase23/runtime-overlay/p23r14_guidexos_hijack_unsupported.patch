--- /dev/null
+++ b/src/coreclr/nativeaot/Runtime/guidexos/PalRedhawkHijackUnsupported.cpp
@@ -0,0 +1,43 @@
+// guideXOS has no NativeAOT-safe cross-thread suspension or return-address
+// write service. Keep the target runtime from advertising an unusable hijack.
+#include "common.h"
+#include "PalRedhawk.h"
+#include "GuidexosGcPal.h"
+
+namespace
+{
+constexpr uint32_t kUnsupportedHijackReason = 0x4758484Au; // "GXHJ"
+constexpr uint32_t kUnknownCetStateReason = 0x47584345u;   // "GXCE"
+
+[[noreturn]] void FailFastUnsupportedHijack(uint32_t reason)
+{
+    guidexos_pal_fail_fast(reason, nullptr);
+    for (;;)
+    {
+    }
+}
+}
+
+// A null result is only safe here because the matching registration provider
+// always rejects the callback, so ThreadStore::Create cannot succeed.
+REDHAWK_PALEXPORT HijackFunc* REDHAWK_PALAPI PalGetHijackTarget(HijackFunc* defaultHijackTarget)
+{
+    (void)defaultHijackTarget;
+    return nullptr;
+}
+
+// Fail closed if any path reaches suspension despite rejected callback
+// registration. Never report successful suspension without a saved context.
+REDHAWK_PALEXPORT void REDHAWK_PALAPI PalHijack(HANDLE hThread, void* pThreadToHijack)
+{
+    (void)hThread;
+    (void)pThreadToHijack;
+    FailFastUnsupportedHijack(kUnsupportedHijackReason);
+}
+
+// guideXOS does not yet expose verified CET/shadow-stack ownership state.
+// Do not report "disabled" based on the boot environment or processor model.
+REDHAWK_PALEXPORT UInt32_BOOL REDHAWK_PALAPI PalAreShadowStacksEnabled()
+{
+    FailFastUnsupportedHijack(kUnknownCetStateReason);
+}
