+    uint32_t tlsIndex = *p_tls_index;
+    TADDR pTls = *(PTR_TADDR)(pTEB + OFFSETOF__TEB__ThreadLocalStoragePointer);
+    if (pTls == NULL)
+        return NULL;
+
+    TADDR pOurTls = *(PTR_TADDR)(pTls + (tlsIndex * sizeof(void*)));
+    if (pOurTls == NULL)
+        return NULL;
+
+    return (PTR_Thread)(pOurTls + SECTIONREL__tls_CurrentThread);
+}
