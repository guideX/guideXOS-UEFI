+#include "StackBoundsContract.h"
@@ -7,9 +8,100 @@
-// GUIDEXOS currently has no PAL contract that can identify the complete,
-// accessible stack allocation owned by the calling OS thread. In particular,
-// the boot handoff's stack and the kernel's later per-thread stacks are not
-// registered with NativeAOT's ThreadStore. Returning an address inferred from
-// RSP would therefore turn a guess into an apparently authoritative bound.
-//
-// Keep thread attachment fail-closed until the OS and PAL provide per-thread
-// stack provenance. Thread::Construct treats false as a fatal initialization
-// failure. Never let the output retain stale caller values on that path.
+#include <atomic>
+#include <intrin.h>
+
+namespace {
+
+using guidexos::stackbounds::Descriptor;
+using guidexos::stackbounds::Failure;
+using guidexos::stackbounds::MemoryMapView;
+
+enum : uint32_t {
+    kUnregistered = 0,
+    kRegistering = 1,
+    kReady = 2,
+};
+
+std::atomic<uint32_t> g_stackDescriptorState{kUnregistered};
+Descriptor g_bootstrapStackDescriptor{};
+
+uintptr_t CurrentStackMarker()
+{
+    // The return-address slot is in this PAL frame on the active stack. It is
+    // used only to associate the calling stack with a trusted descriptor; no
+    // bounds are inferred from this address.
+    return reinterpret_cast<uintptr_t>(_AddressOfReturnAddress());
+}
+
+bool SameDescriptor(const Descriptor& left, const Descriptor& right)
+{
+    return left.Magic == right.Magic && left.Version == right.Version &&
+        left.Kind == right.Kind && left.AllocationLow == right.AllocationLow &&
+        left.AllocationHigh == right.AllocationHigh &&
+        left.AccessibleLow == right.AccessibleLow &&
+        left.AccessibleHigh == right.AccessibleHigh &&
+        left.MappingIdentity == right.MappingIdentity &&
+        left.OwnerIdentity == right.OwnerIdentity &&
+        left.Generation == right.Generation && left.Flags == right.Flags;
+}
+
+bool DescriptorContains(const Descriptor& descriptor, uintptr_t stackMarker)
+{
+    return descriptor.Magic == guidexos::stackbounds::kDescriptorMagic &&
+        descriptor.Version == guidexos::stackbounds::kDescriptorVersion &&
+        descriptor.Kind == guidexos::stackbounds::kKindBootstrap &&
+        (descriptor.Flags & guidexos::stackbounds::kRequiredBootstrapFlags) ==
+            guidexos::stackbounds::kRequiredBootstrapFlags &&
+        descriptor.OwnerIdentity ==
+            guidexos::stackbounds::kBootstrapOwnerIdentity &&
+        descriptor.Generation == guidexos::stackbounds::kBootstrapGeneration &&
+        descriptor.AccessibleLow >= descriptor.AllocationLow &&
+        descriptor.AccessibleHigh <= descriptor.AllocationHigh &&
+        descriptor.AccessibleHigh > descriptor.AccessibleLow &&
+        stackMarker >= descriptor.AccessibleLow &&
+        stackMarker < descriptor.AccessibleHigh;
+}
+
+} // namespace
+
+// Called by the UEFI kernel entry wrapper before KMain can execute managed
+// code. The wrapper passes the active CR3 value after the handoff trampoline
+// has installed it. The descriptor is accepted only when the memory map
+// corroborates its EfiLoaderData allocation and the active stack marker lies
+// in the page-walk-verified interval published by the loader.
+extern "C" bool __stdcall guidexos_pal_register_bootstrap_stack(
+    const Descriptor* descriptor,
+    const void* memoryMap,
+    uint64_t memoryMapEntryCount,
+    uint64_t memoryMapDescriptorSize,
+    uint64_t activePageTableRoot)
+{
+    if (descriptor == nullptr) return false;
+
+    const MemoryMapView map = {
+        static_cast<const uint8_t*>(memoryMap),
+        memoryMapEntryCount,
+        memoryMapDescriptorSize
+    };
+    const uint64_t activeStackMarker =
+        static_cast<uint64_t>(CurrentStackMarker());
+    if (guidexos::stackbounds::Validate(
+            descriptor, map, activePageTableRoot, activeStackMarker) !=
+        Failure::None) {
+        return false;
+    }
+
+    uint32_t expectedState = kUnregistered;
+    if (g_stackDescriptorState.compare_exchange_strong(
+            expectedState, kRegistering,
+            std::memory_order_acq_rel, std::memory_order_acquire)) {
+        // The ready state is the release-published commit point. Readers never
+        // inspect this record while it is being copied.
+        g_bootstrapStackDescriptor = *descriptor;
+        g_stackDescriptorState.store(kReady, std::memory_order_release);
+        return true;
+    }
+
+    if (expectedState != kReady) return false;
+    const Descriptor current = g_bootstrapStackDescriptor;
+    return SameDescriptor(current, *descriptor);
+}
+
