<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>guideXOS.Phase28ManagedSdkProof</AssemblyName>
    <RootNamespace>GuideXos.Phase28ManagedSdkProof</RootNamespace>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier Condition="'$(Phase22Guidexos)' != 'true' and '$(Phase23Guidexos)' != 'true'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true'">guidexos-x64</RuntimeIdentifier>
    <RuntimeFrameworkVersion Condition="'$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true'">9.0.0</RuntimeFrameworkVersion>
    <TargetLatestRuntimePatch Condition="'$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true'">false</TargetLatestRuntimePatch>
    <UseAppHost Condition="'$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true'">false</UseAppHost>
    <RuntimeIdentifierGraphPath Condition="'$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true'">$(MSBuildProjectDirectory)\..\Tools\Phase22\runtime-identifier.graph.json</RuntimeIdentifierGraphPath>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PublishAot>true</PublishAot>
    <SelfContained>true</SelfContained>
    <InvariantGlobalization>true</InvariantGlobalization>
    <TrimMode>link</TrimMode>
    <IlcOptimizationPreference>Size</IlcOptimizationPreference>
    <IlcGenerateMapFile>true</IlcGenerateMapFile>
    <IlcDisableReflection>true</IlcDisableReflection>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <StripSymbols>true</StripSymbols>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <IlcUseEnvironmentalTools>true</IlcUseEnvironmentalTools>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <Phase28Mode Condition="'$(Phase28Mode)' == ''">Success</Phase28Mode>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Phase28Mode)' == 'TypedFailure'">
    <DefineConstants>$(DefineConstants);GUIDEXOS_PHASE28_TYPED_FAILURE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Phase28Mode)' == 'Exit'">
    <DefineConstants>$(DefineConstants);GUIDEXOS_PHASE28_EXIT</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Phase28Mode)' == 'FailFast'">
    <DefineConstants>$(DefineConstants);GUIDEXOS_PHASE28_FAILFAST</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true'">
    <KnownILCompilerPack Update="Microsoft.DotNet.ILCompiler">
      <ILCompilerRuntimeIdentifiers>%(ILCompilerRuntimeIdentifiers);guidexos-x64</ILCompilerRuntimeIdentifiers>
    </KnownILCompilerPack>
    <KnownRuntimePack Update="Microsoft.NETCore.App">
      <RuntimePackRuntimeIdentifiers>%(RuntimePackRuntimeIdentifiers);guidexos-x64</RuntimePackRuntimeIdentifiers>
    </KnownRuntimePack>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuideXos.User\GuideXos.User.csproj" />
    <LinkerArg Include="/base:0x0000401000000000" />
    <LinkerArg Include="/fixed" />
    <PackageReference Include="Microsoft.DotNet.ILCompiler" Version="9.0.0" />
  </ItemGroup>
</Project>
