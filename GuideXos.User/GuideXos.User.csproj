  <Project Sdk="Microsoft.NET.Sdk" TreatAsLocalProperty="RuntimeIdentifier;RuntimeFrameworkVersion;TargetLatestRuntimePatch;UseAppHost;PublishAot;SelfContained;BaseIntermediateOutputPath">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>guidexos-x64</RuntimeIdentifier>
    <RuntimeIdentifierGraphPath>$(MSBuildProjectDirectory)\..\Tools\Phase22\runtime-identifier.graph.json</RuntimeIdentifierGraphPath>
    <RuntimeIdentifier Condition="'$(OutputType)' == 'Exe' and ('$(Phase22Guidexos)' == 'true' or '$(Phase23Guidexos)' == 'true')">guidexos-x64</RuntimeIdentifier>
    <DefineConstants>$(DefineConstants);GUIDEXOS_USER_SDK</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Phase29Mode)' == 'InvalidType'">
    <DefineConstants>$(DefineConstants);GUIDEXOS_PHASE29_INVALID_TYPE</DefineConstants>
  </PropertyGroup>
</Project>
